@page "/"
@inject NavigationManager NavManager

<div class="login-screen">
    <div class="login-container">
        <div class="scanner-line"></div>
        <div class="login-header">
            <h1>SANTOS</h1>
            <p>SystemRise</p>
        </div>

        <div class="login-field">
            <input type="password"
                   class="login-input"
                   placeholder="INTRODUZCA CREDENCIAL.."
                   @bind="passwordInput"
                   @onkeyup="HandleKeyUp" />
        </div>

        <button class="login-btn" @onclick="CheckPassword">
            AUTORIZAR INGRESO
        </button>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p style="color: var(--danger); font-size: 0.7rem; margin-top: 15px; font-family: 'JetBrains Mono';">
                @errorMessage
            </p>
        }

        <div class="login-footer-text">
            Autenticación requerida
        </div>
    </div>
</div>

@code {
    private string passwordInput = "";
    private string errorMessage = "";
    
    // Aquí definimos la contraseña del sistema
    private const string CORRECT_PASSWORD = "SANTOS2026";

    private void CheckPassword()
    {
        if (passwordInput == CORRECT_PASSWORD)
        {
            // Si es correcta, nos vamos a la página de inicio (Index)
            NavManager.NavigateTo("/home");
        }
        else
        {
            errorMessage = "ACCESO DENEGADO: CREDENCIAL INVÁLIDA";
            passwordInput = "";
        }
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") CheckPassword();
    }
}