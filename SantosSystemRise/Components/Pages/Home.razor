@page "/"
@using SantosSystemRise.Services
@using SantosSystemRise.Models
@using System.Timers
@inject RiseControlService ControlService
@implements IDisposable
@rendermode InteractiveServer

@if (!isAuthorized)
{
    @* --- PANTALLA DE LOGIN (EL MURO) - INTACTA --- *@
    <div class="login-screen" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 9999; background: var(--bg-dark);">
        <div class="login-container">
            <div class="scanner-line"></div>
            <div class="login-header">
                <h1>SANTOS</h1>
                <p>SystemRise - Acceso Restringido</p>
            </div>

            <div class="login-field">
                <input type="password"
                       class="login-input"
                       placeholder="INTRODUZCA CREDENCIAL.."
                       @bind="passwordInput"
                       @onkeyup="HandleKeyUp"
                       autofocus />
            </div>

            <button class="login-btn" @onclick="CheckPassword">
                AUTORIZAR INGRESO
            </button>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p style="color: #ff4d4d; font-size: 0.7rem; margin-top: 15px; font-family: 'JetBrains Mono'; text-align: center;">
                    @errorMessage
                </p>
            }

            <div class="login-footer-text">
                Protocolo de Seguridad Activo
            </div>
        </div>
    </div>
}
else
{
    @* --- CONTENIDO PRINCIPAL - ESTRUCTURA RESPETADA AL 100% --- *@
    <div class="system-container animate-fade-in">
        <header class="main-header animate-pop">
            <div class="brand-title">
                <span class="brand-santos-glow">SANTOS</span><span class="brand-sub">SystemRise</span>
            </div>

            <div style="display:flex; gap:12px;">
                <button class="add-device-btn" @onclick="WakeAllDevices">
                    <i class="bi bi-lightning-charge-fill"></i> ENCENDER TODOS
                </button>
                <button class="add-device-btn" @onclick="WakeSelectedDevices">
                    <i class="bi bi-broadcast-pin"></i> ENCENDER SELECCIONADOS
                </button>
                <button class="add-device-btn" @onclick="() => OpenModal()">
                    <i class="bi bi-plus-circle-fill"></i> REGISTRAR TERMINAL
                </button>
                <button class="action-btn btn-delete" style="margin-left:10px;" @onclick="() => isAuthorized = false" title="Cerrar Sesión">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            </div>
        </header>

        <div class="select-tools mt-4">
            <button class="add-device-btn" @onclick="ToggleSelectAll">
                @selectAllLabel
            </button>
            <span class="selected-counter">
                @selectedCount equipos seleccionados
            </span>
        </div>

        <div class="device-list">
            <div class="list-labels">
                <span class="col-check"></span>
                <span class="col-main">DISPOSITIVO</span>
                <span class="col-mac">DIRECCIÓN MAC</span>
                <span class="col-actions">ACCIONES</span>
            </div>

            @foreach (var device in Devices)
            {
                <div class="device-row animate-pop @(device.IsSelected ? "selected" : "")"
                     style="border-left: 4px solid @GetStatusColor(device.Status)">
                    
                    <input type="checkbox" @bind="device.IsSelected" class="device-check" />

                    <div class="col-main">
                        <div class="device-icon-box">
                            @* Añadimos el color dinámico al icono *@
                            <i class="bi @(string.IsNullOrEmpty(device.TypeIcon) ? "bi-pc-display" : device.TypeIcon) @(device.Status == DeviceStatus.Waking ? "spin" : "")"
                               style="color: @GetStatusColor(device.Status)"></i>
                        </div>
                        <div class="device-info">
                            <div class="device-name">@device.Name</div>
                            @if (!string.IsNullOrEmpty(device.IpAddress))
                            {
                                <small style="color: #666; font-size: 0.7rem;">IP: @device.IpAddress</small>
                            }
                        </div>
                    </div>

                    <div class="col-mac">
                        <code class="mac-badge">@device.MacAddress</code>
                    </div>

                    <div class="col-actions">
                        @* Cambiamos a IndividualWake para manejar el estado Naranja *@
                        <button class="action-btn btn-power" title="Enviar Pulse" @onclick="() => IndividualWake(device)">
                            <i class="bi bi-lightning-charge-fill"></i>
                        </button>
                        <button class="action-btn btn-edit" title="Editar" @onclick="() => OpenModal(device.MacAddress)">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="action-btn btn-delete" title="Eliminar" @onclick="() => Remove(device.MacAddress)">
                            <i class="bi bi-trash3-fill"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    @* --- MODAL DE REGISTRO/EDICIÓN - AÑADIDO CAMPO IP --- *@
    @if (showModal)
    {
        <div class="modal-overlay">
            <div class="modal-content animate-pop">
                <div class="modal-header-premium">
                    <h3>@(isEditing ? "EDITAR EQUIPO" : "NUEVO EQUIPO")</h3>
                    <p>Protocolo de encendido remoto activo</p>
                </div>
                
                <div class="form-body">
                    <div class="input-group">
                        <label>NOMBRE</label>
                        <input @bind="tempDevice.Name" class="form-input" placeholder="Ej: Estación CNC 01" />
                    </div>
                    <div class="input-group">
                        <label>DIRECCIÓN IP</label>
                        <input @bind="tempDevice.IpAddress" class="form-input" placeholder="172.16.x.x" />
                    </div>
                    <div class="input-group">
                        <label>DIRECCIÓN MAC</label>
                        <input @bind="tempDevice.MacAddress" class="form-input" placeholder="00:00:00:00:00:00" disabled="@isEditing" />
                    </div>
                </div>

                <div class="modal-footer-premium">
                    <button @onclick="Save" class="btn-save">GUARDAR CAMBIOS</button>
                    <button @onclick="() => showModal = false" class="btn-cancel">CANCELAR</button>
                </div>
            </div>
        </div>
    }
}

@code {
    // --- SEGURIDAD ---
    private bool isAuthorized = false;
    private string passwordInput = "";
    private string errorMessage = "";
    private const string CORRECT_PASSWORD = "SANTOS2026";

    private void CheckPassword()
    {
        if (passwordInput == CORRECT_PASSWORD) { isAuthorized = true; errorMessage = ""; }
        else { errorMessage = "ACCESO DENEGADO"; passwordInput = ""; }
    }

    private void HandleKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") CheckPassword(); }

    // --- LÓGICA DE DISPOSITIVOS ---
    private bool showModal = false, isEditing = false, allSelected = false;
    private Device tempDevice = new();
    private List<Device> Devices = new();
    private System.Timers.Timer? _refreshTimer;

    private string selectAllLabel => allSelected ? "DESELECCIONAR TODO" : "SELECCIONAR TODO";
    private int selectedCount => Devices.Count(d => d.IsSelected);

    protected override async Task OnInitializedAsync()
    {
        await LoadDevices();
        
        // Configuramos el timer para refrescar estados cada 10 segundos
        _refreshTimer = new System.Timers.Timer(10000);
        _refreshTimer.Elapsed += async (s, e) => await InvokeAsync(RefreshStatuses);
        _refreshTimer.AutoReset = true;
        _refreshTimer.Enabled = true;
    }

    private async Task LoadDevices() => Devices = await ControlService.GetAllDevices();

    private async Task RefreshStatuses()
    {
        if (!isAuthorized || showModal) return;
        foreach (var d in Devices.Where(x => x.Status != DeviceStatus.Waking))
        {
            if (string.IsNullOrEmpty(d.IpAddress)) continue;
            bool isOnline = await ControlService.IsDeviceOnline(d.IpAddress);
            d.Status = isOnline ? DeviceStatus.Online : DeviceStatus.Offline;
        }
        StateHasChanged();
    }

    private async Task IndividualWake(Device d)
    {
        if (d.Status == DeviceStatus.Waking) return;
        d.Status = DeviceStatus.Waking; // Naranja
        StateHasChanged();

        await ControlService.SendMagicPacket(d.MacAddress);

        // Esperar 15 seg para el primer ping tras encendido
        _ = Task.Delay(15000).ContinueWith(async _ =>
        {
            bool online = await ControlService.IsDeviceOnline(d.IpAddress);
            d.Status = online ? DeviceStatus.Online : DeviceStatus.Offline;
            await InvokeAsync(StateHasChanged);
        });
    }

    private void OpenModal(string mac = null)
    {
        if (!string.IsNullOrEmpty(mac))
        {
            var d = Devices.FirstOrDefault(x => x.MacAddress == mac);
            if (d != null)
            {
                tempDevice = new Device { Name = d.Name, MacAddress = d.MacAddress, IpAddress = d.IpAddress };
                isEditing = true;
            }
        }
        else { tempDevice = new Device(); isEditing = false; }
        showModal = true;
    }

    private async Task Save()
    {
        if (!string.IsNullOrWhiteSpace(tempDevice.Name) && !string.IsNullOrWhiteSpace(tempDevice.MacAddress))
        {
            if (isEditing) await ControlService.UpdateDevice(tempDevice);
            else await ControlService.AddDevice(tempDevice);
            await LoadDevices();
            showModal = false;
        }
    }

    private async Task Remove(string mac) { await ControlService.RemoveDevice(mac); await LoadDevices(); }
    private void ToggleSelectAll() { allSelected = !allSelected; foreach (var d in Devices) d.IsSelected = allSelected; }
    private async Task WakeAllDevices() { foreach (var d in Devices) await IndividualWake(d); }
    private async Task WakeSelectedDevices() { foreach (var d in Devices.Where(x => x.IsSelected)) await IndividualWake(d); }
    
    private string GetStatusColor(DeviceStatus s) => s switch
    {
        DeviceStatus.Online => "#00ff88",
        DeviceStatus.Waking => "#ffa500",
        _ => "#444444"
    };

    public void Dispose() => _refreshTimer?.Dispose();
}