@page "/home"
@using SantosSystemRise.Services
@using SantosSystemRise.Models
@inject RiseControlService ControlService
@rendermode InteractiveServer

<div class="system-container">
    <header class="main-header animate-pop">
        <div class="brand-title">
            <span class="brand-santos-glow">SANTOS</span><span class="brand-sub">SystemRise</span>
        </div>

        <div style="display:flex; gap:12px;">
            <button class="add-device-btn" @onclick="WakeAllDevices">
                <i class="bi bi-lightning-charge-fill"></i> ENCENDER TODOS
            </button>

            <button class="add-device-btn" @onclick="WakeSelectedDevices">
                <i class="bi bi-broadcast-pin"></i> ENCENDER SELECCIONADOS
            </button>

            <button class="add-device-btn" @onclick="() => OpenModal()">
                <i class="bi bi-plus-circle-fill"></i> REGISTRAR TERMINAL
            </button>
        </div>
    </header>

    <div class="select-tools mt-4">
        <button class="add-device-btn" @onclick="ToggleSelectAll">
            @selectAllLabel
        </button>

        <span class="selected-counter">
            @selectedCount equipos seleccionados
        </span>
    </div>

    <div class="device-list">
        <div class="list-labels">
            <span class="col-check"></span>
            <span class="col-main">DISPOSITIVO</span>
            <span class="col-mac">DIRECCIÓN MAC</span>
            <span class="col-actions">ACCIONES</span>
        </div>

        @foreach (var device in Devices)
        {
            <div class="device-row animate-pop @(device.IsSelected ? "selected" : "")">
                <input type="checkbox" @bind="device.IsSelected" class="device-check" />

                <div class="col-main">
                    <div class="device-icon-box">
                        <i class="bi @(string.IsNullOrEmpty(device.TypeIcon) ? "bi-pc-display" : device.TypeIcon)"></i>
                    </div>
                    <div class="device-info">
                        <div class="device-name">@device.Name</div>
                    </div>
                </div>

                <div class="col-mac">
                    <code class="mac-badge">@device.MacAddress</code>
                </div>

                <div class="col-actions">
                    <button class="action-btn btn-power" title="Enviar Rise-Pulse" @onclick="() => ControlService.SendMagicPacket(device.Id)">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </button>
                    <button class="action-btn btn-edit" title="Editar" @onclick="() => OpenModal(device.Id)">
                        <i class="bi bi-pencil-square"></i>
                    </button>
                    <button class="action-btn btn-delete" title="Eliminar" @onclick="() => Remove(device.Id)">
                        <i class="bi bi-trash3-fill"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@if (showModal)
{
    <div class="modal-overlay">
        <div class="modal-content animate-pop">
            <div class="modal-header-premium">
                <h3>@(isEditing ? "EDITAR EQUIPO" : "NUEVO EQUIPO")</h3>
                <p>Protocolo de encendido remoto activo</p>
            </div>
            
            <div class="form-body">
                <div class="input-group">
                    <label>NOMBRE</label>
                    <input @bind="tempDevice.Name" class="form-input" placeholder="Ej: Estación CNC 01" />
                </div>
                <div class="input-group">
                    <label>DIRECCIÓN MAC</label>
                    <input @bind="tempDevice.MacAddress" class="form-input" placeholder="00:00:00:00:00:00" />
                </div>
                <div class="input-group">
                    <label>IP BROADCAST</label>
                    <input @bind="tempDevice.BroadcastIP" class="form-input" />
                </div>
            </div>

            <div class="modal-footer-premium">
                <button @onclick="Save" class="btn-save">GUARDAR CAMBIOS</button>
                <button @onclick="() => showModal = false" class="btn-cancel">CANCELAR</button>
            </div>
        </div>
    </div>
}

@code {
    private bool showModal = false;
    private bool isEditing = false;
    private Device tempDevice = new();
    private List<Device> Devices = new();

    /* 🔥 Selección global */
    private bool allSelected = false;
    private string selectAllLabel => allSelected ? "DESELECCIONAR TODO" : "SELECCIONAR TODO";
    private int selectedCount => Devices.Count(d => d.IsSelected);

    private void ToggleSelectAll()
    {
        allSelected = !allSelected;
        foreach (var d in Devices)
            d.IsSelected = allSelected;
    }

    protected override async Task OnInitializedAsync()
    {
        Devices = await ControlService.GetAllDevices();
    }

    private void OpenModal(int? id = null)
    {
        if (id.HasValue)
        {
            var d = Devices.FirstOrDefault(x => x.Id == id);
            if (d != null)
            {
                tempDevice = new Device
                {
                    Id = d.Id,
                    Name = d.Name,
                    // Hostname eliminado de la asignación
                    MacAddress = d.MacAddress,
                    BroadcastIP = d.BroadcastIP
                };
                isEditing = true;
            }
        }
        else
        {
            tempDevice = new Device
            {
                BroadcastIP = "172.16.255.255"
            };
            isEditing = false;
        }
        showModal = true;
    }

    private async Task Save()
    {
        if (!string.IsNullOrWhiteSpace(tempDevice.Name))
        {
            if (isEditing)
                await ControlService.UpdateDevice(tempDevice);
            else
                await ControlService.AddDevice(tempDevice);

            Devices = await ControlService.GetAllDevices();
            showModal = false;
        }
    }

    private async Task Remove(int id)
    {
        await ControlService.RemoveDevice(id);
        Devices = await ControlService.GetAllDevices();
    }

    private async Task WakeAllDevices()
    {
        foreach (var d in Devices)
            await ControlService.SendMagicPacket(d.Id);
    }

    private async Task WakeSelectedDevices()
    {
        var selected = Devices.Where(d => d.IsSelected).ToList();
        foreach (var d in selected)
            await ControlService.SendMagicPacket(d.Id);
    }
}