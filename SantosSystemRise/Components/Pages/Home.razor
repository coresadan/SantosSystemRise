@page "/"
@using SantosSystemRise.Services
@using SantosSystemRise.Models
@inject RiseControlService ControlService
@rendermode InteractiveServer

<div class="system-container">
    <header class="main-header animate-pop">
        <div class="brand-title">
            <span class="brand-santos-glow">SANTOS</span><span class="brand-sub">SystemRise</span>
        </div>
        <button class="add-device-btn" @onclick="() => OpenModal()">
            <i class="bi bi-plus-circle-fill"></i> REGISTRAR TERMINAL
        </button>
    </header>

    <div class="device-list">
        @* Cabecera con clases de columna para alineación quirúrgica *@
        <div class="list-labels">
            <span class="col-main">DISPOSITIVO</span>
            <span class="col-mac">DIRECCIÓN MAC</span>
            <span class="col-actions">ACCIONES</span>
        </div>

        @foreach (var device in ControlService.GetAllDevices())
        {
            <div class="device-row animate-pop">
                @* Columna 1: Icono y Nombre *@
                <div class="col-main">
                    <div class="device-icon-box">
                        <i class="bi @(string.IsNullOrEmpty(device.TypeIcon) ? "bi-pc-display" : device.TypeIcon)"></i>
                    </div>
                    <div class="device-name">@device.Name</div>
                </div>

                @* Columna 2: MAC con badge centrado *@
                <div class="col-mac">
                    <code class="mac-badge">@device.MacAddress</code>
                </div>

                @* Columna 3: Botones alineados a la derecha *@
                <div class="col-actions">
                    <button class="action-btn btn-power" title="Enviar Rise-Pulse" @onclick="() => ControlService.SendMagicPacket(device.Id)">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </button>
                    <button class="action-btn btn-edit" title="Editar" @onclick="() => OpenModal(device.Id)">
                        <i class="bi bi-pencil-square"></i>
                    </button>
                    <button class="action-btn btn-delete" title="Eliminar" @onclick="() => Remove(device.Id)">
                        <i class="bi bi-trash3-fill"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@if (showModal)
{
    <div class="modal-overlay">
        <div class="modal-content animate-pop">
            <div class="modal-header-premium">
                <h3 style="font-family: 'Orbitron', sans-serif; color: var(--accent); margin-bottom: 5px;">
                    @(isEditing ? "EDITAR EQUIPO" : "NUEVO EQUIPO")
                </h3>
                <p style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 25px;">Protocolo de encendido remoto</p>
            </div>
            
            <div class="form-body">
                <div class="input-group">
                    <label style="display: block; font-size: 0.7rem; color: var(--accent); margin-bottom: 5px;">NOMBRE</label>
                    <input @bind="tempDevice.Name" class="form-input" placeholder="Ej: Estación CNC 01" />
                </div>
                <div class="input-group">
                    <label style="display: block; font-size: 0.7rem; color: var(--accent); margin-bottom: 5px;">HOSTNAME</label>
                    <input @bind="tempDevice.Hostname" class="form-input" placeholder="SANTOS-PC01" />
                </div>
                <div class="input-group">
                    <label style="display: block; font-size: 0.7rem; color: var(--accent); margin-bottom: 5px;">DIRECCIÓN MAC</label>
                    <input @bind="tempDevice.MacAddress" class="form-input" placeholder="00:00:00:00:00:00" />
                </div>
                <div class="input-group">
                    <label style="display: block; font-size: 0.7rem; color: var(--accent); margin-bottom: 5px;">IP BROADCAST</label>
                    <input @bind="tempDevice.BroadcastIP" class="form-input" />
                </div>
            </div>

            <div class="modal-footer-premium" style="display: flex; gap: 15px; margin-top: 30px;">
                <button @onclick="Save" class="add-device-btn" style="flex: 1; background: var(--accent); color: var(--bg-dark);">GUARDAR</button>
                <button @onclick="() => showModal = false" class="add-device-btn" style="flex: 1; border-color: var(--danger); color: var(--danger);">CANCELAR</button>
            </div>
        </div>
    </div>
}

@code {
    private bool showModal = false;
    private bool isEditing = false;
    private Device tempDevice = new();

    private void OpenModal(int? id = null)
    {
        if (id.HasValue)
        {
            var d = ControlService.GetAllDevices().FirstOrDefault(x => x.Id == id);
            if (d != null)
            {
                tempDevice = new Device
                {
                    Id = d.Id,
                    Name = d.Name,
                    Hostname = d.Hostname,
                    MacAddress = d.MacAddress,
                    BroadcastIP = d.BroadcastIP,
                    TypeId = d.TypeId
                };
                isEditing = true;
            }
        }
        else
        {
            tempDevice = new Device { BroadcastIP = "172.16.255.255", TypeId = 1 };
            isEditing = false;
        }
        showModal = true;
    }

    private void Save()
    {
        if (!string.IsNullOrWhiteSpace(tempDevice.Name))
        {
            if (isEditing) ControlService.UpdateDevice(tempDevice);
            else ControlService.AddDevice(tempDevice);
            showModal = false;
        }
    }

    private void Remove(int id) => ControlService.RemoveDevice(id);
}