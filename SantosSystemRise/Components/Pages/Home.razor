@page "/"
@using SantosSystemRise.Services
@using SantosSystemRise.Models
@using System.Net.Sockets
@using Console = System.Console
@using BootstrapBlazor.Components
@using Microsoft.Extensions.Localization
@inject RiseControlService ControlService
@inject ToastService ToastService
@inject IJSRuntime JS
@rendermode InteractiveServer

@if (!isAuthorized)
{
    @* --- PANTALLA DE LOGIN --- *@
    <div class="login-screen">
        <div class="login-container">
            <div class="scanner-line"></div>
            <div class="login-header">
                <h1>SANTOS</h1>
                <p>SystemRise - Acceso Restringido</p>
            </div>

            <div class="login-field">
                <i class="bi bi-shield-lock login-icon" style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--accent); opacity: 0.7;"></i>
                <input type="password"
                       class="login-input"
                       placeholder="INTRODUZCA CREDENCIAL.."
                       @bind="passwordInput"
                       @bind:event="oninput"
                       @onkeyup="HandleKeyUp"
                       autofocus />
            </div>

            <button class="login-btn" @onclick="CheckPassword">
                AUTORIZAR INGRESO
            </button>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p style="color: #ff4d4d; font-size: 0.7rem; margin-top: 15px; font-family: 'JetBrains Mono'; text-align: center;">
                    @errorMessage
                </p>
            }

            <div class="login-footer-text">
                Protocolo de Seguridad Activo v3.0
            </div>
        </div>
    </div>
}
else
{
    @* --- CONTENIDO PRINCIPAL --- *@
    <div class="system-container animate-fade-in">
        <header class="main-header animate-pop">
            <div class="brand-title">
                <span class="brand-santos-glow">SANTOS</span><span class="brand-sub">SystemRise</span>
            </div>

            @* BARRA DE BÚSQUEDA *@
            <div class="search-box-premium" style="flex-grow: 1; max-width: 300px; margin: 0 20px; position: relative; background: rgba(255,255,255,0.05); border-radius: 8px; padding: 5px 15px; border: 1px solid rgba(255,255,255,0.1); display: flex; align-items: center;">
                <i class="bi bi-search" style="color: var(--accent); margin-right: 10px;"></i>
                <input type="text" @bind="searchTerm" @bind:event="oninput"
                       placeholder="Filtrar por Nombre, IP o MAC..."
                       style="background: transparent; border: none; color: white; outline: none; width: 100%; font-size: 0.85rem;" />
            </div>

            <div style="display:flex; gap:12px; align-items: center; flex-wrap: wrap;">
                <button class="add-device-btn" @onclick="ManualRefresh" title="Refrescar">
                    <i class="bi bi-arrow-clockwise @(isRefreshing ? "spin" : "")"></i>
                </button>

                <button class="add-device-btn" @onclick="ToggleTheme" title="Cambiar Tema">
                    <i class="bi @(isLightMode ? "bi-moon-stars-fill" : "bi-sun-fill")"></i>
                </button>

                <button class="add-device-btn" @onclick="WakeAllDevices">
                    <i class="bi bi-lightning-charge-fill"></i> ENCENDER TODOS
                </button>
    
                <button class="add-device-btn" @onclick="WakeSelectedDevices">
                    <i class="bi bi-broadcast-pin"></i> SELECCIONADOS
                </button>
    
                <button class="add-device-btn" @onclick="() => OpenModal()">
                    <i class="bi bi-plus-circle-fill"></i> REGISTRAR
                </button>

                <button class="add-device-btn btn-logout-danger" @onclick="() => isAuthorized = false" title="Cerrar Sesión">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            </div>
        </header>

        <div class="select-tools mt-4">
            <button class="add-device-btn" @onclick="ToggleSelectAll">
                <i class="bi @(allSelected ? "bi-check-all" : "bi-square")"></i> @selectAllLabel
            </button>
            <span class="selected-counter">
                @selectedCount equipos seleccionados
            </span>
        </div>

        <div class="device-list">
            <div class="list-labels">
                <span class="col-check"></span>
                <span class="col-main">DISPOSITIVO</span>
                <span class="col-mac">DIRECCIÓN MAC</span>
                <span class="col-actions">ACCIONES</span>
            </div>

            @foreach (var device in FilteredDevices)
            {
                <div class="device-row animate-pop @(device.IsSelected ? "selected" : "")"
                     style="border-left: 4px solid @GetStatusColor(device.Status)">
                    
                    <div class="col-check">
                        <input type="checkbox" @bind="device.IsSelected" class="device-check" />
                    </div>

                    <div class="col-main">
                        <div class="device-icon-box">
                            <i class="bi @(string.IsNullOrEmpty(device.TypeIcon) ? "bi-pc-display" : device.TypeIcon) @(device.Status == DeviceStatus.Waking ? "spin" : "")"
                               style="color: @GetStatusColor(device.Status)"></i>
                        </div>
                        <div class="device-info">
                            <div class="device-name">@device.Name</div>
                            @if (!string.IsNullOrEmpty(device.IpAddress))
                            {
                                <small style="color: var(--text-muted); font-size: 0.7rem; font-family: 'JetBrains Mono';">IP: @device.IpAddress</small>
                            }
                        </div>
                    </div>

                    <div class="col-mac">
                        <code class="mac-badge">@device.MacAddress</code>
                    </div>

                    <div class="col-actions">
                        <button class="action-btn btn-power" title="Encender / Ping" @onclick="() => IndividualWake(device)">
                            <i class="bi @(device.Status == DeviceStatus.Waking ? "bi-arrow-repeat spin" : "bi-lightning-charge-fill")"></i>
                        </button>
                        <button class="action-btn btn-edit" title="Editar" @onclick="() => OpenModal(device.MacAddress)">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="action-btn btn-delete" title="Eliminar" @onclick="() => Remove(device.MacAddress)">
                            <i class="bi bi-trash3-fill"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    @* --- MODAL --- *@
    @if (showModal)
    {
        <div class="modal-overlay">
            <div class="modal-content animate-pop">
                <div class="modal-header-premium">
                    <h3>@(isEditing ? "EDITAR EQUIPO" : "NUEVO EQUIPO")</h3>
                    <p>Protocolo de encendido remoto activo</p>
                </div>
                
                <div class="form-body">
                    <div class="input-group">
                        <label>NOMBRE</label>
                        <input @bind="tempDevice.Name" class="form-input" placeholder="Ej: Estación CNC 01" />
                    </div>
                    <div class="input-group">
                        <label>DIRECCIÓN IP</label>
                        <input @bind="tempDevice.IpAddress" class="form-input" placeholder="172.16.x.x" />
                    </div>
                    <div class="input-group">
                        <label>DIRECCIÓN MAC</label>
                        <input @bind="tempDevice.MacAddress" class="form-input" placeholder="00:00:00:00:00:00" disabled="@isEditing" />
                    </div>
                </div>

                <div class="modal-footer-premium">
                    <button @onclick="Save" class="btn-save">GUARDAR CAMBIOS</button>
                    <button @onclick="() => showModal = false" class="btn-cancel">CANCELAR</button>
                </div>
            </div>
        </div>
    }
}

@code {
    private string searchTerm = "";
    private bool isAuthorized = false;
    private string passwordInput = "";
    private string errorMessage = "";
    private const string CORRECT_PASSWORD = "santos2026";
    private bool isLightMode = false;
    private bool isRefreshing = false;

    private bool showModal = false, isEditing = false, allSelected = false;
    private Device tempDevice = new();
    private List<Device> Devices = new();

    // Lógica de filtrado en tiempo real
    private IEnumerable<Device> FilteredDevices => string.IsNullOrWhiteSpace(searchTerm)
        ? Devices
        : Devices.Where(d =>
            (d.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (d.IpAddress?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (d.MacAddress?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false));

    private string selectAllLabel => allSelected ? "DESELECCIONAR" : "SELECCIONAR TODO";
    private int selectedCount => Devices.Count(d => d.IsSelected);

    protected override async Task OnInitializedAsync()
    {
        await LoadDevices();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckDevicesConnection();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ManualRefresh()
    {
        if (isRefreshing) return;
        isRefreshing = true;
    
        Console.WriteLine("\n[SANTOS-SYS] Solicitud de refresco manual iniciada...");
        await CheckDevicesConnection();
    
        isRefreshing = false;

        await Notificar("SISTEMA", "Refresco de red completado.", ToastCategory.Success);

        Console.WriteLine("[SANTOS-SYS] Refresco manual completado.");
    }

    private async Task LoadDevices() => Devices = await ControlService.GetAllDevices();

    private async Task ToggleTheme()
    {
        isLightMode = !isLightMode;
        await JS.InvokeVoidAsync("eval", isLightMode ? "document.body.classList.add('light-mode')" : "document.body.classList.remove('light-mode')");
    }

    private void CheckPassword()
    {
        if (passwordInput.ToLower() == CORRECT_PASSWORD) { isAuthorized = true; errorMessage = ""; }
        else { errorMessage = "CREDENCIAL INVÁLIDA"; passwordInput = ""; }
    }

    private void HandleKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") CheckPassword(); }

    private async Task<bool> CheckRealStatus(string ip, string name, int attempt = 0, int total = 0)
    {
        if (string.IsNullOrEmpty(ip)) return false;
        try
        {
            using var ping = new System.Net.NetworkInformation.Ping();
            var reply = await ping.SendPingAsync(ip, 800);
            bool success = reply.Status == System.Net.NetworkInformation.IPStatus.Success;

            string progress = (attempt > 0 && total > 0) ? $"[{attempt}/{total}] " : "[INFO] ";
            string status = success ? "ONLINE" : "OFFLINE";
            Console.WriteLine($"[SANTOS-SYS] {progress}Equipo: {name.PadRight(15)} IP: {ip.PadRight(15)} -> {status}");

            return success;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SANTOS-SYS] [ERROR] Fallo de red en {name}: {ex.Message}");
            return false;
        }
    }

    // --- ACCIÓN PRINCIPAL REORGANIZADA ---
    private async Task IndividualWake(Device d)
    {
        if (d.Status == DeviceStatus.Waking) return;
        
        d.Status = DeviceStatus.Waking;
        await InvokeAsync(StateHasChanged);
        
        // 1. Encapsulamos el envío físico del paquete
        await SendWakeUpProtocol(d);

        // 2. Encapsulamos la verificación en segundo plano
        _ = Task.Run(async () => await WaitAndVerifyStatus(d));
    }

    private async Task SendWakeUpProtocol(Device d)
    {
        Console.WriteLine($"\n[SANTOS-SYS] >>> Lanzando Protocolo WOL (Magic Packet) -> {d.Name}");
        await ControlService.SendMagicPacket(d.MacAddress);
    }

    private async Task WaitAndVerifyStatus(Device d)
    {
        // El ping corre en segundo plano
        bool found = await SmartPing(d.IpAddress, d.Name, 5, 20000);
        d.Status = found ? DeviceStatus.Online : DeviceStatus.Offline;

        // Forzamos que TODO lo que afecta a la UI ocurra en el hilo principal
        await InvokeAsync(async () =>
        {
            if (found)
            {
                Console.WriteLine($"[SANTOS-SYS] [ÉXITO] {d.Name} ONLINE.");
                await Notificar("SANTOS SYS: ÉXITO", $"[OK] {d.Name} respondió correctamente.", ToastCategory.Success);
            }
            else
            {
                Console.WriteLine($"[SANTOS-SYS] [FALLO] {d.Name} OFFLINE.");
                await Notificar("SANTOS SYS: ERROR", $"[FALLO] {d.Name} no respondió tras los reintentos.", ToastCategory.Error);
            }
        
            StateHasChanged();
        });
    }

    // --- LÓGICA DE RED ---
    private async Task<bool> SmartPing(string ip, string name, int retries, int delayMs)
    {
        Console.WriteLine($"\n[SANTOS-SYS] >>> Seguimiento: {name.ToUpper()}");
    
        for (int i = 1; i <= retries; i++)
        {
            // Notificamos CADA intento antes de hacerlo
            await Notificar("SANTOS-SYS: STATUS", $"[{i}/{retries}] Verificando conexión con {name}...", ToastCategory.Information);

            if (await CheckRealStatus(ip, name, i, retries)) return true;

            if (i < retries)
            {
                // Log en consola
                Console.WriteLine($"[SANTOS-SYS] Intento {i} fallido. Reintentando en {delayMs / 1000}s...");
            
                // Notificamos el fallo del intento actual en la web
                await Notificar("SANTOS-SYS: REINTENTO", $"[{i}/{retries}] Falló. Esperando {delayMs / 1000}s...", ToastCategory.Warning);
            
                await Task.Delay(delayMs);
            }
            delayMs += 20000;
        }
        return false;
    }

    private async Task CheckDevicesConnection()
    {
        Console.WriteLine("\n[SANTOS-SYS] --- INICIANDO ESCANEO DE RED ---");
        var tasks = Devices.Select(async d =>
        {
            if (d.Status == DeviceStatus.Waking || string.IsNullOrEmpty(d.IpAddress)) return;
            bool isAlive = await CheckRealStatus(d.IpAddress, d.Name);
            d.Status = isAlive ? DeviceStatus.Online : DeviceStatus.Offline;
        });
        await Task.WhenAll(tasks);
        Console.WriteLine("[SANTOS-SYS] --- ESCANEO DE RED FINALIZADO ---");
    }

    // --- GESTIÓN DE DATOS ---
    private async Task Save()
    {
        if (!string.IsNullOrWhiteSpace(tempDevice.Name) && !string.IsNullOrWhiteSpace(tempDevice.MacAddress))
        {
            if (isEditing) await ControlService.UpdateDevice(tempDevice);
            else await ControlService.AddDevice(tempDevice);
            
            await LoadDevices();
            await CheckDevicesConnection();
            showModal = false;
            
            await Notificar("BASE DE DATOS", "Cambios guardados con éxito.", ToastCategory.Success);
        }
    }

    private async Task Remove(string mac)
    {
        var device = Devices.FirstOrDefault(x => x.MacAddress == mac);
        Console.WriteLine($"[SANTOS-SYS] Eliminando equipo: {device?.Name ?? mac}");
        await ControlService.RemoveDevice(mac);
        await LoadDevices();
        
        await Notificar("SISTEMA", "Equipo eliminado del registro.", ToastCategory.Warning);
    }

    private void OpenModal(string mac = null)
    {
        if (!string.IsNullOrEmpty(mac))
        {
            var d = Devices.FirstOrDefault(x => x.MacAddress == mac);
            if (d != null)
            {
                tempDevice = new Device { Name = d.Name, MacAddress = d.MacAddress, IpAddress = d.IpAddress, TypeIcon = d.TypeIcon };
                isEditing = true;
            }
        }
        else { tempDevice = new Device { TypeIcon = "bi-pc-display" }; isEditing = false; }
        showModal = true;
    }

    private void ToggleSelectAll() { allSelected = !allSelected; foreach (var d in Devices) d.IsSelected = allSelected; }
    
    private async Task WakeAllDevices()
    {
        Console.WriteLine("[SANTOS-SYS] Ejecutando encendido masivo...");
        foreach (var d in Devices) await IndividualWake(d);
    }
    
    private async Task WakeSelectedDevices()
    {
        Console.WriteLine($"[SANTOS-SYS] Encendiendo {selectedCount} equipos seleccionados...");
        foreach (var d in Devices.Where(x => x.IsSelected)) await IndividualWake(d);
    }
    
    private string GetStatusColor(DeviceStatus s) => s switch
    {
        DeviceStatus.Online => "#00ff88",
        DeviceStatus.Waking => "#ffa500",
        _ => isLightMode ? "#cbd5e1" : "#334155"
    };

    private async Task Notificar(string titulo, string msg, ToastCategory cat)
    {
        await InvokeAsync(async () =>
        {
            await ToastService.Show(new ToastOption()
            {
                Category = cat,
                Title = titulo,
                Content = msg,
                Delay = 6000,
            });
            StateHasChanged();
        });
    }
}